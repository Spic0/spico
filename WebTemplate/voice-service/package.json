{
  "name": "spico-voice-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Separate persistent Node.js service for Telnyx + OpenAI Realtime voice (Milestone 8). Independent of the Next.js app — see README.md.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "selftest": "tsx src/selfTest.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/ws": "8.18.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
