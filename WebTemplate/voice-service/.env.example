# spico-voice-service — copy to .env.local (or set real env vars) and fill in.
# Never commit real secrets. .env.local is gitignored.

# Local HTTP/WS port for this service.
PORT=4001

# Same live Supabase project as the main app (Project Settings -> API).
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key — server-to-server only, this service has no user session.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Shared secret this service requires on POST /calls/simulate (Authorization:
# Bearer <secret>). Generate any random string for local testing.
VOICE_SERVICE_SHARED_SECRET=replace-with-a-random-string

# =============================================================================
# M15 live activation. Leave these UNSET to keep the stub/simulate behavior.
# The service auto-detects: real Telnyx is used only when TELNYX_API_KEY +
# TELNYX_PUBLIC_KEY are set; real OpenAI Realtime only when OPENAI_API_KEY is
# set. A fully-live inbound call additionally needs PUBLIC_BASE_URL. See
# README.md "Activating live Telnyx + OpenAI Realtime" for the full runbook.
# =============================================================================

# --- Telnyx Call Control ---
# API key (Call Control commands): portal -> API Keys.
# TELNYX_API_KEY=
# Public Key for webhook Ed25519 verification: portal -> Public Key.
# TELNYX_PUBLIC_KEY=
# Reject webhooks whose telnyx-timestamp is older than this many seconds.
TELNYX_WEBHOOK_TOLERANCE_SECONDS=300
# Optional outbound connection/voice-profile id used for transfers.
# TELNYX_CONNECTION_ID=

# --- OpenAI Realtime ---
# OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy

# --- Public reachability (required for a live inbound call) ---
# The public HTTPS base URL Telnyx can reach this service at (e.g. an ngrok URL
# or a real deployment). Telnyx webhook -> ${PUBLIC_BASE_URL}/webhooks/telnyx,
# media stream -> derived wss ${PUBLIC_BASE_URL -> wss}/realtime.
# PUBLIC_BASE_URL=https://your-tunnel-or-host.example.com

# --- Production-safe fallback ---
# E.164 number to transfer to when the AI path can't run (no agent, provider
# error, no public URL, etc.). If unset, fallback speaks an apology and hangs up.
# VOICE_FALLBACK_NUMBER=+15551234567
