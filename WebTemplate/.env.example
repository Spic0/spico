# Spico — environment variables example
# Copy to .env.local and fill in real values. Never commit .env.local.
# Every variable here must also be declared in lib/env.ts and validated with Zod.

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# --- Supabase ----------------------------------------------------------------
# Project settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server-only. Never expose to the client, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- Redis / Upstash (M9: Open API rate limiting + request idempotency) -----
# Optional. When unset, rate limiting/idempotency are inactive but nothing
# errors — see lib/rateLimit.ts. Create a free Redis database at
# https://console.upstash.com and copy its REST URL/token.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Demo/test data seeding (M12) --------------------------------------------
# Must be explicitly "true" to allow the internal test-data seeding tool
# (Hotel Owner + Platform Superadmin only) to run at all — see
# lib/demoData.ts. Defaults to false. NEVER set true in a deployment serving
# real tenants/guests.
ENABLE_DEMO_DATA_SEEDING=false

# =============================================================================
# Everything below is RESERVED for later milestones (see docs/roadmap.md).
# No code reads these yet — listed now only so the shape of future config is
# visible. Do not populate with real secrets until the corresponding milestone
# is actually implemented.
# =============================================================================

# --- Voice (M8) ---------------------------------------------------------------
# Built as a SEPARATE persistent Node.js service, not part of this Next.js app
# — see voice-service/.env.example and voice-service/README.md. This app does
# not read TELNYX_*/OPENAI_API_KEY/VOICE_SERVICE_* — it only reads the
# calls/call_events/hotel_voice_settings tables that service writes to.
